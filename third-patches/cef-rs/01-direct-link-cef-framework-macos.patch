+            let needs_recreate = match std::fs::read_link(&link) {
+                Ok(existing) => existing != src,
+                Err(_) => true,
+            };
+            if needs_recreate {
+                if link.is_symlink() || link.is_file() {
+                    std::fs::remove_file(&link)?;
+                } else if link.exists() {
+                    std::fs::remove_dir_all(&link)?;
