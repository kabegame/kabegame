+  #[test]
+  #[cfg(not(target_os = "android"))]
+  fn cargo_target_dir_recognized() {
+    use std::{ffi::OsString, path::Path};
+
+    let target = || Some(OsString::from("/path/to/target-dev"));
+    assert!(super::is_in_cargo_target_dir(
+      Path::new("/path/to/target-dev/debug"),
+      target()
+    ));
+    assert!(super::is_in_cargo_target_dir(
+      Path::new("/path/to/target-dev/aarch64-apple-darwin/debug"),
+      target()
+    ));
+    assert!(!super::is_in_cargo_target_dir(
+      Path::new("/path/to/target-dev/a/b/debug"),
