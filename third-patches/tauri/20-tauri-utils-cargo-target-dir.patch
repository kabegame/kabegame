+/// kabegame: whether `exe_dir` is `<target>/<profile>` or `<target>/<triple>/<profile>` of the
+/// target directory cargo was pointed at with `CARGO_TARGET_DIR` (`cargo run` passes its own
+/// environment on to the executable). Upstream only recognizes a directory literally named
+/// `target`, so on macOS / Linux an executable built into a renamed target directory is taken
+/// for an installed app and the resource directory cannot be resolved. A relative value is
+/// resolved against the current directory, the same way cargo resolves it.
+#[cfg(not(target_os = "android"))]
+fn is_in_cargo_target_dir(
+  exe_dir: &std::path::Path,
+  target_dir: Option<std::ffi::OsString>,
+) -> bool {
+  let Some(target_dir) = target_dir.filter(|dir| !dir.is_empty()) else {
+    return false;
+  };
+  let target_dir = std::path::PathBuf::from(target_dir);
+  let target_dir = if target_dir.is_absolute() {
+    target_dir
+  } else {
+    match std::env::current_dir() {
+      Ok(cwd) => cwd.join(target_dir),
+      Err(_) => return false,
+    }
+  };
+  let canonical = |path: &std::path::Path| {
+    path
+      .canonicalize()
+      .unwrap_or_else(|_| path.to_path_buf())
+  };
+  let target_dir = canonical(&target_dir);
+  let exe_dir = canonical(exe_dir);
+  let parent = exe_dir.parent();
+  parent == Some(target_dir.as_path())
+    || parent.and_then(std::path::Path::parent) == Some(target_dir.as_path())
+}
