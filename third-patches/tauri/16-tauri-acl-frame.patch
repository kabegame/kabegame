+      windows: vec![Pattern::new("main").unwrap()],
+      frames,
+      ..Default::default()
+    };
+    let authority = RuntimeAuthority::new(
+      Default::default(),
+      Resolved {
+        allowed_commands: [(command.to_string(), vec![resolved(CapabilityFrames::Any)])]
+          .into_iter()
+          .collect(),
+        // denied by a capability that only applies to subframes
+        denied_commands: [(command.to_string(), vec![resolved(CapabilityFrames::Sub)])]
+          .into_iter()
+          .collect(),
+        ..Default::default()
+      },
+    );
+    for frame in [IpcFrame::Main, IpcFrame::Sub, IpcFrame::Unknown] {
+      assert!(
+        authority
+          .resolve_access(command, "main", "main", &Origin::Local, frame)
+          .is_none(),
+        "{frame:?}"
+      );
+    }
+  }
