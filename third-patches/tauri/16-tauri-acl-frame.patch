+  #[test]
+  fn resolve_access_filters_by_frame() {
+    use tauri_utils::acl::capability::CapabilityFrames;
+
+    let command = "my-command";
+    let resolved = |frames| ResolvedCommand {
+      windows: vec![Pattern::new("main").unwrap()],
+      frames,
+      ..Default::default()
+    };
+    let authority_for = |frames| {
+      RuntimeAuthority::new(
+        Default::default(),
+        Resolved {
+          allowed_commands: [(command.to_string(), vec![resolved(frames)])]
+            .into_iter()
+            .collect(),
+          ..Default::default()
+        },
+      )
+    };
+    let access = |authority: &RuntimeAuthority, frame| {
+      authority
+        .resolve_access(command, "main", "main", &Origin::Local, frame)
+        .is_some()
+    };
+
+    // the default capability only applies to the main frame
+    let main = authority_for(CapabilityFrames::default());
+    assert!(access(&main, IpcFrame::Main));
+    assert!(!access(&main, IpcFrame::Sub));
+    assert!(!access(&main, IpcFrame::Unknown));
+
+    let sub = authority_for(CapabilityFrames::Sub);
+    assert!(!access(&sub, IpcFrame::Main));
+    assert!(access(&sub, IpcFrame::Sub));
+    assert!(!access(&sub, IpcFrame::Unknown));
+
+    let any = authority_for(CapabilityFrames::Any);
+    assert!(access(&any, IpcFrame::Main));
+    assert!(access(&any, IpcFrame::Sub));
+    assert!(access(&any, IpcFrame::Unknown));
+
+    // the message names the frame of the rejected request and the frames of the grants
+    let message = sub.resolve_access_message(
+      tauri_utils::acl::APP_ACL_KEY,
+      command,
+      "main",
+      "main",
+      &Origin::Local,
+      IpcFrame::Main,
+    );
+    assert!(message.contains("from main frame"), "{message}");
+    assert!(message.contains("frames: sub"), "{message}");
+  }
