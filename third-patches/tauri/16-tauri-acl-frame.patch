+  /// The top-level frame of the webview.
+  #[default]
+  Main,
+  /// A subframe (iframe) of the webview.
+  Sub,
+  /// The runtime cannot tell which frame sent the request (e.g. a service worker sent it).
+  Unknown,
+}
