+      (CapabilityFrames::Main, IpcFrame::Unknown, false),
+      (CapabilityFrames::Sub, IpcFrame::Main, false),
+      (CapabilityFrames::Sub, IpcFrame::Sub, true),
+      (CapabilityFrames::Sub, IpcFrame::Unknown, false),
+      (CapabilityFrames::Any, IpcFrame::Main, true),
+      (CapabilityFrames::Any, IpcFrame::Sub, true),
