+    let channel = JavaScriptChannelId::from_str("__CHANNEL__:9")
+      .unwrap()
+      .channel_on_frame::<_, InvokeResponseBody>(window.webview.clone(), sub("frame-a"));
+
+    // small payloads are evaluated directly in the subframe
+    dispatcher.clear_evaluated_scripts();
+    channel.send(json_body("\"small\"")).unwrap();
+    let scripts = dispatcher.evaluated_scripts();
+    assert_eq!(scripts.len(), 1);
+    assert_eq!(scripts[0].0.as_ref(), Some(&frame));
+    assert!(scripts[0].1.contains("small"));
+
+    // large payloads ask the subframe to fetch them
+    dispatcher.clear_evaluated_scripts();
+    channel
+      .send(InvokeResponseBody::Raw(vec![
+        7;
+        MAX_RAW_DIRECT_EXECUTE_THRESHOLD
+      ]))
+      .unwrap();
+    let scripts = dispatcher.evaluated_scripts();
+    assert_eq!(scripts.len(), 1);
+    assert_eq!(scripts[0].0.as_ref(), Some(&frame));
+    assert!(scripts[0].1.contains(FETCH_CHANNEL_DATA_COMMAND));
+    let data_id = scripts[0]
+      .1
+      .split(&format!("'{CHANNEL_ID_HEADER_NAME}': '"))
+      .nth(1)
+      .and_then(|rest| rest.split('\'').next())
+      .unwrap()
+      .to_string();
+
+    let fetch = |frame: IpcFrame, subframe_id: Option<SubframeId>| {
+      let mut headers = http::HeaderMap::new();
+      headers.insert(CHANNEL_ID_HEADER_NAME, data_id.parse().unwrap());
+      get_ipc_response(
+        &window,
+        InvokeRequest {
+          cmd: FETCH_CHANNEL_DATA_COMMAND.into(),
+          callback: CallbackFn(0),
+          error: CallbackFn(1),
+          url: "tauri://localhost".parse().unwrap(),
+          body: InvokeBody::default(),
+          headers,
+          invoke_key: INVOKE_KEY.to_string(),
+          frame,
+          subframe_id,
+        },
+      )
+    };
+
+    // the main frame, another subframe and an unaddressable request all guess the id in vain
+    assert!(fetch(IpcFrame::Main, None).is_err());
+    assert!(fetch(IpcFrame::Sub, Some(SubframeId::new("frame-b"))).is_err());
+    assert!(fetch(IpcFrame::Sub, None).is_err());
+    assert!(fetch(IpcFrame::Unknown, None).is_err());
+    // the frame the data was sent to gets it, once
+    assert_eq!(
+      fetch(IpcFrame::Sub, Some(frame.clone())),
+      Ok(InvokeResponseBody::Raw(vec![
+        7;
+        MAX_RAW_DIRECT_EXECUTE_THRESHOLD
+      ]))
+    );
+    assert!(fetch(IpcFrame::Sub, Some(frame)).is_err());
+  }
 }
