+
+  /// JS listeners receive `emit_to` events by the identity of their webview, whatever target the
+  /// JS side sent: the webview label, the hosting window label and, for a webview window, both.
+  #[test]
+  fn js_emit_to_uses_receiver_identity() {
+    use crate::sealed::ManagerBase;
+
+    let app = mock_app();
+
+    // A window hosting two webviews, plus a regular webview window.
+    let multi = WindowBuilder::new(&app, "multi").build().unwrap();
+    let multi_a = multi
+      .add_child(
+        WebviewBuilder::new("multi-a", Default::default()),
+        crate::LogicalPosition::new(0, 0),
+        multi.inner_size().unwrap(),
+      )
+      .unwrap();
+    let multi_b = multi
+      .add_child(
+        WebviewBuilder::new("multi-b", Default::default()),
+        crate::LogicalPosition::new(0, 0),
+        multi.inner_size().unwrap(),
+      )
+      .unwrap();
+    let solo = WebviewWindowBuilder::new(&app, "solo", Default::default())
+      .build()
+      .unwrap()
+      .webview;
+
+    let webviews = [&multi_a, &multi_b, &solo];
+    let listeners = app.manager().listeners();
+    let event = crate::EventName::new(TEST_EVENT_NAME).unwrap();
+    for webview in webviews {
+      // registered as a JS `listen` would be, with no target stored
+      listeners.listen_js(
+        event.as_str_event(),
+        webview.label(),
+        listeners.next_event_id(),
+      );
+    }
+
+    let mut n = 0;
+    let mut delivered_to = |target: EventTarget| {
+      n += 1;
+      let payload = format!("payload-{n}");
+      app.emit_to(target, TEST_EVENT_NAME, &payload).unwrap();
+      webviews
+        .iter()
+        .filter(|webview| {
+          webview
+            .webview
+            .dispatcher
+            .last_evaluated_script()
+            .is_some_and(|script| script.contains(&payload))
+        })
+        .map(|webview| webview.label().to_string())
+        .collect::<Vec<_>>()
+    };
+
+    assert_eq!(
+      delivered_to(EventTarget::labeled("multi")),
+      ["multi-a", "multi-b"]
+    );
+    assert_eq!(delivered_to(EventTarget::labeled("multi-a")), ["multi-a"]);
+    assert_eq!(delivered_to(EventTarget::labeled("solo")), ["solo"]);
+    assert_eq!(
+      delivered_to(EventTarget::window("multi")),
+      ["multi-a", "multi-b"]
+    );
+    assert_eq!(delivered_to(EventTarget::window("solo")), ["solo"]);
+    assert_eq!(delivered_to(EventTarget::webview("multi-b")), ["multi-b"]);
+    assert_eq!(delivered_to(EventTarget::webview("solo")), ["solo"]);
+    assert_eq!(delivered_to(EventTarget::webview_window("solo")), ["solo"]);
+    // no webview is both named and hosted by "multi"
+    assert!(delivered_to(EventTarget::webview_window("multi")).is_empty());
+    assert!(delivered_to(EventTarget::webview_window("multi-a")).is_empty());
+    // the app is not a JS receiver
+    assert!(delivered_to(EventTarget::App).is_empty());
+    assert!(delivered_to(EventTarget::labeled("nobody")).is_empty());
+    assert_eq!(
+      delivered_to(EventTarget::Any),
+      ["multi-a", "multi-b", "solo"]
+    );
+  }
 }
