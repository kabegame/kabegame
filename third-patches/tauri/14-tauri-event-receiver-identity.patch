+/// Every identity a webview has as an event receiver: its own label as a webview, the label of the
+/// window hosting it, and, when the window hosts only this webview under the same label, the
+/// webview window. An `emit_to` target is delivered if it accepts any of them.
+fn receiver_identities<R: Runtime>(webview: &Webview<R>) -> Vec<EventTarget> {
+  receiver_identities_for(webview.label(), &webview.window_label())
+}
+
+fn receiver_identities_for(webview_label: &str, window_label: &str) -> Vec<EventTarget> {
+  let mut identities = vec![
+    EventTarget::webview(webview_label),
+    EventTarget::window(window_label),
+  ];
+  if webview_label == window_label {
+    identities.push(EventTarget::webview_window(webview_label));
+  }
+  identities
+}
