+  /// Drops every event listener registered from JavaScript in this webview
+  /// (listeners added from Rust with `listen` are not affected).
+  ///
+  /// JS listeners are tracked per webview label and only removed when the webview is destroyed:
+  /// navigating to a new document keeps the old document's listeners, and every later matching
+  /// event is still delivered by evaluating a script in the new document.
+  /// Embedders that navigate a long-lived webview between documents call this once they know the
+  /// document was replaced. Listeners the new document registers afterwards are kept as usual.
+  pub fn clear_js_listeners(&self) {
+    self
+      .manager()
+      .listeners()
+      .remove_webview_js_listeners(self.label());
+  }
