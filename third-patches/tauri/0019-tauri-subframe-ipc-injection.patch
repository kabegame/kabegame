+  /// The subframe bridge is exactly Tauri's own main-frame bridge (same strings, same order), and
+  /// leaves out plugin initialization scripts and the scripts the webview was built with.
+  #[test]
+  fn subframe_bridge_scripts_are_the_main_frame_bridge() {
+    use crate::{sealed::ManagerBase, test::mock_app};
+    use tauri_runtime::webview::WebviewAttributes;
+
+    let app = mock_app();
+    let mut attributes = WebviewAttributes::new(WebviewUrl::default());
+    attributes
+      .initialization_scripts
+      .push(InitializationScript {
+        script: "window.customScript = 1".into(),
+        for_main_frame_only: false,
+      });
+    let pending = PendingWebview::new(attributes, "main").unwrap();
+    let pending = app
+      .manager()
+      .webview
+      .prepare_pending_webview(pending, "main", "main", &app)
+      .unwrap();
+    let attributes = &pending.webview_attributes;
+    let bridge = &attributes.subframe_bridge_scripts;
+
+    assert_eq!(bridge.len(), 4);
+    for (script, initialization) in bridge.iter().zip(&attributes.initialization_scripts) {
+      assert_eq!(script, &initialization.script);
+      assert!(initialization.for_main_frame_only);
+    }
+    assert!(bridge[0].contains("isTauri"));
+    assert!(bridge[1].contains(app.manager().webview.invoke_key()));
+    assert!(bridge[2].contains("currentWebview"));
+    assert!(
+      bridge
+        .iter()
+        .all(|script| !script.contains("window.customScript"))
+    );
+    // the webview's own scripts still follow the bridge in the main frame list
+    assert!(
+      attributes
+        .initialization_scripts
+        .iter()
+        .any(|script| script.script == "window.customScript = 1" && !script.for_main_frame_only)
+    );
+  }
+
