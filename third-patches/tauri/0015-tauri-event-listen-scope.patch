 use super::EventName;
 use super::EventTarget;
+use super::ListenScope;
 
 /// The `target` the JS API still sends is ignored: a webview receives an event targeted with
 /// `emit_to` only if it is the target itself (see [`crate::Emitter::emit_to`]).
+///
+/// The event name must pass the [`ListenScope`] of the `core:event:allow-listen` grants
+/// that apply to the request.
 #[command(root = "crate")]
 async fn listen<R: Runtime>(
   webview: Webview<R>,
   event: EventName,
   handler: CallbackFn,
+  scope: CommandScope<ListenScope>,
 ) -> Result<EventId> {
+  if !scope.matches(event.as_str()) {
+    return Err(listen_denied(event.as_str()));
+  }
   webview.listen_js(event.as_str_event(), handler)
 }
 
+fn listen_denied(event: &str) -> crate::Error {
+  crate::Error::Anyhow(anyhow::anyhow!(
+    "event `{event}` is not allowed to be listened by ACL"
+  ))
+}
