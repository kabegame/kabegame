@@ -18,6 +18,37 @@ use crate::ipc::CallbackFn;
 /// Unique id of an event.
 pub type EventId = u32;
 
+/// Scope entry of the `core:event:allow-listen` permission: which event names a webview may listen to.
+///
+/// `event` is a full event name; a trailing `*` matches every event name starting with the part before it.
+/// As with other command scopes, a `deny` entry wins over any `allow` entry, and once any `allow`
+/// entry applies to the request the event must match one of them. A grant without a scope does not
+/// restrict event names.
+///
+/// ```json
+/// {
+///   "identifier": "core:event:allow-listen",
+///   "allow": [{ "event": "surf-*" }],
+///   "deny": [{ "event": "surf-internal" }]
+/// }
+/// ```
+#[derive(Debug, Clone, Deserialize)]
+pub struct ListenScope {
+  /// Event name, or an event name prefix followed by `*`.
+  pub event: String,
+}
+
+impl crate::ipc::ScopeObjectMatch for ListenScope {
+  type Input = str;
+
+  fn matches(&self, input: &str) -> bool {
+    match self.event.strip_suffix('*') {
+      Some(prefix) => input.starts_with(prefix),
+      None => input == self.event,
+    }
+  }
+}
+
