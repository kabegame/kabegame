+#[cfg(test)]
+mod tests {
+  use std::collections::BTreeMap;
+
+  use serde_json::json;
+  use tauri_utils::acl::{
+    ExecutionContext,
+    resolved::{Resolved, ResolvedCommand, ResolvedScope},
+  };
+
+  use crate::{
+    WebviewWindow, WebviewWindowBuilder,
+    ipc::{CallbackFn, InvokeBody},
+    test::{INVOKE_KEY, MockRuntime, get_ipc_response, mock_builder, mock_context, noop_assets},
+    webview::InvokeRequest,
+  };
+
+  const LISTEN: &str = "plugin:event|listen";
+
+  /// One `core:event:allow-listen` grant per entry, for the `main` window: `None` is a grant without
+  /// a scope, `Some((allow, deny))` a grant extended with that scope.
+  fn app_with_listen_grants(
+    grants: Vec<Option<(serde_json::Value, serde_json::Value)>>,
+  ) -> WebviewWindow<MockRuntime> {
+    let mut command_scope = BTreeMap::new();
+    let mut resolved = Vec::new();
+    for (index, grant) in grants.into_iter().enumerate() {
+      let scope_id = grant.map(|(allow, deny)| {
+        let id = index as u64 + 1;
+        let values = |v: serde_json::Value| match v {
+          serde_json::Value::Array(items) => items.into_iter().map(Into::into).collect(),
+          _ => unreachable!(),
+        };
+        command_scope.insert(
+          id,
+          ResolvedScope {
+            allow: values(allow),
+            deny: values(deny),
+          },
+        );
+        id
+      });
+      resolved.push(ResolvedCommand {
+        context: ExecutionContext::Local,
+        windows: vec!["main".parse().unwrap()],
+        scope_id,
+        ..Default::default()
+      });
+    }
+
+    let mut context = mock_context(noop_assets());
+    *context.runtime_authority_mut() = crate::runtime_authority!(
+      Default::default(),
+      Resolved {
+        allowed_commands: [(LISTEN.to_string(), resolved)].into_iter().collect(),
+        command_scope,
+        ..Default::default()
+      }
+    );
+    let app = mock_builder().build(context).unwrap();
+    WebviewWindowBuilder::new(&app, "main", Default::default())
+      .build()
+      .unwrap()
+  }
+
+  fn listen(webview: &WebviewWindow<MockRuntime>, event: &str) -> Result<(), String> {
+    get_ipc_response(
+      webview,
+      InvokeRequest {
+        cmd: LISTEN.into(),
+        callback: CallbackFn(0),
+        error: CallbackFn(1),
+        url: "tauri://localhost".parse().unwrap(),
+        body: InvokeBody::Json(json!({ "event": event, "handler": 7 })),
+        headers: Default::default(),
+        invoke_key: INVOKE_KEY.to_string(),
+      },
+    )
+    .map(|_| ())
+    .map_err(|e| e.to_string())
+  }
+
+  #[test]
+  fn listen_scope_exact_prefix_and_deny() {
+    let webview = app_with_listen_grants(vec![Some((
+      json!([{ "event": "surf-url-changed" }, { "event": "app-*" }]),
+      json!([{ "event": "app-log*" }]),
+    ))]);
+
+    assert!(listen(&webview, "surf-url-changed").is_ok());
+    // exact entries do not match longer names
+    assert!(listen(&webview, "surf-url-changed-2").is_err());
+    // a trailing `*` is a prefix match
+    assert!(listen(&webview, "app-import-plugin").is_ok());
+    assert!(listen(&webview, "app-").is_ok());
+    // deny wins over allow, prefixes included
+    let denied = listen(&webview, "app-log").unwrap_err();
+    assert!(
+      denied.contains("is not allowed to be listened by ACL"),
+      "{denied}"
+    );
+    assert!(listen(&webview, "app-logs").is_err());
+    // not listed
+    assert!(listen(&webview, "images-added").is_err());
+  }
+
+  #[test]
+  fn listen_without_scope_is_unrestricted() {
+    let webview = app_with_listen_grants(vec![None]);
+    assert!(listen(&webview, "images-added").is_ok());
+    assert!(listen(&webview, "anything/at:all").is_ok());
+  }
+
+  #[test]
+  fn deny_only_scope_blocks_just_the_denied_events() {
+    let webview = app_with_listen_grants(vec![Some((json!([]), json!([{ "event": "app-log" }])))]);
+    assert!(listen(&webview, "images-added").is_ok());
+    assert!(listen(&webview, "app-log").is_err());
+  }
+
+  #[test]
+  fn any_scoped_grant_restricts_the_request() {
+    // one unscoped and one scoped grant apply to the same webview: the scope still applies
+    let webview = app_with_listen_grants(vec![
+      None,
+      Some((json!([{ "event": "setting-change" }]), json!([]))),
+    ]);
+    assert!(listen(&webview, "setting-change").is_ok());
+    assert!(listen(&webview, "images-added").is_err());
+  }
+}
