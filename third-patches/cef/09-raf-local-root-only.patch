     # cleared by RenderWidgetHostImpl::FilterDropData).
     'name': 'kabegame_drag_source_filenames',
+  },
+  {
+    # kabegame: each frame widget's BeginMainFrame services only the documents
+    # of its own local root, so N same-process OOPIFs of one page no longer run
+    # every document's animation frame callbacks N times per frame.
+    # web_frame_widget_impl.cc is also modified by views_widget.patch; this
+    # patch is relative to that state. Do not resave it with patch_updater.py.
+    'name': 'kabegame_raf_local_root_only',
   }
 ]
