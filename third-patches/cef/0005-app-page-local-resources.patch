+void GrantLoadLocalResources(blink::WebLocalFrame* frame) {
+  if (!frame) {
+    return;
+  }
+
+  blink::LocalFrame* core_frame =
+      blink::To<blink::WebLocalFrameImpl>(frame)->GetFrame();
+  if (!core_frame) {
+    return;
+  }
+
+  blink::LocalDOMWindow* window = core_frame->DomWindow();
+  if (!window) {
