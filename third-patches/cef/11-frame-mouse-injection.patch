+  /// own a widget. May be called on any browser process thread; runs on the UI
+  /// thread (synchronously when called there).
+  ///
+  /*--cef(added=experimental)--*/
+  virtual void SendMouseMoveEventToFrame(double x,
+                                         double y,
+                                         uint32_t modifiers,
