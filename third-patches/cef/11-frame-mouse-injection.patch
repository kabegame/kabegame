+bool CefFrameHostImpl::ConvertPointFromView(double view_x,
+                                             double view_y,
+                                             double& frame_x,
+                                             double& frame_y,
+                                             double& frame_width,
+                                             double& frame_height) {
+  CEF_REQUIRE_UIT_RETURN(false);
+  auto browser = GetBrowserHostBase();
+  if (!browser) {
+    return false;
+  }
+  content::RenderWidgetHostViewBase* root_view = nullptr;
+  content::RenderWidgetHostViewBase* frame_view = nullptr;
+  if (!GetFrameViews(GetRenderFrameHost(), browser->GetWebContents(),
+                     &root_view, &frame_view)) {
+    return false;
+  }
+
+  // Inverse of the compositor's screen-space transform between the two views,
+  // so ancestor CSS transforms, scrolling, CSS zoom and page scale are all
+  // included. Points outside the frame are mapped as well (no clamping).
+  gfx::PointF point;
+  if (frame_view == root_view) {
+    point = gfx::PointF(static_cast<float>(view_x), static_cast<float>(view_y));
+  } else if (!root_view->TransformPointToCoordSpaceForView(
+                 gfx::PointF(static_cast<float>(view_x),
+                             static_cast<float>(view_y)),
+                 frame_view, &point)) {
+    return false;
+  }
+
+  // The frame's own (untransformed) viewport size in DIP. GetViewBounds() is
+  // integral for child frames, so derive it from the pixel size instead.
+  gfx::SizeF size;
+  if (frame_view == root_view) {
+    size = gfx::SizeF(root_view->GetViewBounds().size());
+  } else {
+    const float scale = frame_view->GetDeviceScaleFactor();
+    size = gfx::ScaleSize(gfx::SizeF(frame_view->GetCompositorViewportPixelSize()),
+                          scale > 0 ? 1.f / scale : 1.f);
+  }
+
+  frame_x = point.x();
+  frame_y = point.y();
+  frame_width = size.width();
+  frame_height = size.height();
+  return true;
+}
+
+void CefFrameHostImpl::SendMouseMoveEventToFrame(double x,
+                                                 double y,
+                                                 uint32_t modifiers,
+                                                 bool mouse_leave) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    CEF_POST_TASK(CEF_UIT,
+                  base::BindOnce(&CefFrameHostImpl::SendMouseMoveEventToFrame,
+                                 this, x, y, modifiers, mouse_leave));
+    return;
+  }
+  ForwardMouseEventToFrame(
+      static_cast<int>(mouse_leave ? blink::WebInputEvent::Type::kMouseLeave
+                                   : blink::WebInputEvent::Type::kMouseMove),
+      x, y, modifiers,
+      static_cast<int>(blink::WebPointerProperties::Button::kNoButton), 0);
+}
+
+void CefFrameHostImpl::SendMouseClickEventToFrame(double x,
+                                                  double y,
+                                                  uint32_t modifiers,
+                                                  cef_mouse_button_type_t type,
+                                                  bool mouse_up,
+                                                  int click_count) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    CEF_POST_TASK(
+        CEF_UIT,
+        base::BindOnce(&CefFrameHostImpl::SendMouseClickEventToFrame, this, x,
+                       y, modifiers, type, mouse_up, click_count));
+    return;
+  }
+  blink::WebPointerProperties::Button button;
+  switch (type) {
+    case MBT_LEFT:
+      button = blink::WebPointerProperties::Button::kLeft;
+      break;
+    case MBT_MIDDLE:
+      button = blink::WebPointerProperties::Button::kMiddle;
+      break;
+    case MBT_RIGHT:
+      button = blink::WebPointerProperties::Button::kRight;
+      break;
+    default:
+      return;
+  }
+  ForwardMouseEventToFrame(
+      static_cast<int>(mouse_up ? blink::WebInputEvent::Type::kMouseUp
+                                : blink::WebInputEvent::Type::kMouseDown),
+      x, y, modifiers, static_cast<int>(button), click_count);
+}
+
+void CefFrameHostImpl::ForwardMouseEventToFrame(int type,
+                                                double x,
+                                                double y,
+                                                uint32_t modifiers,
+                                                int button,
+                                                int click_count) {
+  CEF_REQUIRE_UIT();
+  auto browser = GetBrowserHostBase();
+  if (!browser) {
+    return;
+  }
+  content::RenderWidgetHostViewBase* root_view = nullptr;
+  content::RenderWidgetHostViewBase* frame_view = nullptr;
+  if (!GetFrameViews(GetRenderFrameHost(), browser->GetWebContents(),
+                     &root_view, &frame_view)) {
+    return;
+  }
+
+  const gfx::PointF position(static_cast<float>(x), static_cast<float>(y));
+  // Same as DevTools' Input.dispatchMouseEvent for a frame target
+  // (ConvertWidgetPointToScreenPoint in input_handler.cc).
+  const gfx::PointF screen_position =
+      position + frame_view->GetViewBounds().OffsetFromOrigin();
+  blink::WebMouseEvent event(
+      static_cast<blink::WebInputEvent::Type>(type), position, screen_position,
+      static_cast<blink::WebPointerProperties::Button>(button), click_count,
+      TranslateFrameMouseModifiers(modifiers), ui::EventTimeForNow());
+
+  // Straight to the frame's own widget, like DevTools' InputInjector but
+  // without Focus(): this bypasses the input event router (and therefore any
+  // ancestor content covering the frame), native capture and keyboard focus,
+  // and the cursor manager.
+  frame_view->GetRenderWidgetHost()->ForwardMouseEvent(event);
+}
