+    // Kabegame: per-browser opt-in for file:// documents reading other file://
+    // URLs (fetch / XHR). This is the per-WebContents equivalent of the global
+    // --allow-file-access-from-files switch, enabled only for browsers created
+    // with the extra_info key below (Wallpaper Engine web wallpapers loaded from
+    // their own directory). The embedder is responsible for confining which
+    // file:// URLs such a browser may load, e.g. in OnBeforeResourceLoad.
+    if (auto extra_info = browser->browser_info()->extra_info()) {
+      const CefString key("kabegame.allow_file_access_from_file_urls");
+      if (extra_info->HasKey(key) &&
+          extra_info->GetType(key) == VTYPE_BOOL && extra_info->GetBool(key)) {
+        prefs->allow_file_access_from_file_urls = true;
+      }
+    }
