+std::vector<ui::FileInfo>
+ChromeWebContentsViewDelegateCef::GetDragFilenames(
+    const content::DropData& drop_data) {
+  auto browser = CefBrowserHostBase::GetBrowserForContents(web_contents_);
+  if (!browser) {
+    return {};
+  }
+  auto client = browser->client();
+  if (!client) {
+    return {};
+  }
+  auto handler = client->GetDragHandler();
+  if (!handler) {
+    return {};
+  }
+
+  // Deliberately writable, unlike the OnDrop path: the point of this callback
+  // is to let the client push local paths into a drag the renderer could not
+  // express.
+  CefRefPtr<CefDragDataImpl> cef_drag_data(new CefDragDataImpl(drop_data));
+  handler->OnStartDragging(browser.get(), cef_drag_data.get());
+
+  base::AutoLock lock_scope(cef_drag_data->lock());
+  return cef_drag_data->drop_data()->filenames;
+}
