+void AlloyBrowserHostImpl::PreHandleDragUpdate(
+    const content::DropData& drop_data,
+    const gfx::PointF& client_pt) {
+  CefRefPtr<CefDragHandler> handler;
+  if (client_) {
+    handler = client_->GetDragHandler();
+  }
+  if (handler) {
+    handler->OnDragOver(this,
+                        CefPoint(static_cast<int>(client_pt.x()),
+                                 static_cast<int>(client_pt.y())),
+                        static_cast<CefDragHandler::DragOperationsMask>(
+                            current_drag_operations_mask_));
+  }
+}
+
+void AlloyBrowserHostImpl::PreHandleDragExit() {
+  CefRefPtr<CefDragHandler> handler;
+  if (client_) {
+    handler = client_->GetDragHandler();
+  }
+  if (handler) {
+    handler->OnDragLeave(this);
+  }
+}
