+
+void ChromeWebContentsViewDelegateCef::OnPerformingDrop(
+    const content::DropData& drop_data,
+    DropCompletionCallback callback) {
+  // Give the client a chance to consume the drop before it reaches the
+  // renderer. A consumed drop is aborted, which suppresses the default
+  // handling (e.g. navigating to a dropped file).
+  if (auto browser = CefBrowserHostBase::GetBrowserForContents(web_contents_)) {
+    if (auto client = browser->client()) {
+      if (auto handler = client->GetDragHandler()) {
+        CefRefPtr<CefDragDataImpl> cef_drag_data(new CefDragDataImpl(drop_data));
+        cef_drag_data->SetReadOnly(true);
+        if (handler->OnDrop(browser.get(), cef_drag_data.get())) {
+          std::move(callback).Run(std::nullopt);
+          return;
+        }
+      }
+    }
+  }
+
+  ChromeWebContentsViewDelegateBase::OnPerformingDrop(drop_data,
+                                                      std::move(callback));
+}
