{
  "mcpServers": {
    "kabegame": {
      "type": "http",
      "url": "http://127.0.0.1:7490/mcp"
    },
    "agent-browser": {
      "command": "deno",
      "args": ["run", "-A", "npm:agent-browser", "mcp"]
    },
    "renderdoc": {
      "command": "uv",
      "args": ["--directory", "ignore/RenderDocMCP", "run", "renderdoc-mcp"]
    },
    "kabegame-dev": {
      "command": "deno",
      "args": [
        "run",
        "--allow-net=127.0.0.1,localhost",
        "--allow-read",
        "--allow-write",
        "--allow-env",
        "apps/kabegame-dev-mcp/src/main.ts"
      ]
    }
  }
}
