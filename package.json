{
  "name": "kabegame",
  "description": "让你的桌面充满二次元气息的壁纸管理器！收集、管理、轮播，让老婆们（或老公们）每天陪伴你~ 支持插件扩展，轻松爬取各种二次元壁纸资源~",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "src-tauri-plugins/tauri-plugin-picker",
    "src-tauri-plugins/tauri-plugin-share"
  ],
  "scripts": {
    "dev": "deno run -A scripts/run.ts dev",
    "start": "deno run -A scripts/run.ts start",
    "b": "deno run -A scripts/run.ts build",
    "check": "deno run -A scripts/run.ts check",
    "test": "deno run -A scripts/run.ts test",
    "dev:frontend": "deno task --cwd apps/kabegame dev",
    "//": "以下命令为构建前端的命令，通过 deno task b 调用不要直接调用因为没有设置相关环境变量",
    "build-kabegame": "deno task --cwd apps/kabegame build",
    "set-version": "deno run -A scripts/set-version.ts",
    "patch": "deno run -A scripts/patch-manager.ts",
    "docs:dev": "deno task --cwd apps/docs dev",
    "docs:build": "deno task --cwd apps/docs build",
    "build:ffmpeg": "deno run -A scripts/build-ffmpeg.ts",
    "build:chromium": "deno run -A scripts/build-chromium.ts",
    "build:v8": "deno run -A scripts/build-v8.ts",
    "build:deno": "deno run -A scripts/build-deno.ts",
    "build:web": "deno run -A scripts/build-web.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vueuse/core": "^14.4.0",
    "lodash-es": "^4.18.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/tsconfig": "^0.5.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "glob": "^13.0.6",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "sass": "^1.102.0",
    "sharp": "^0.34.5",
    "tapable": "^2.3.3",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "deno": ">=2.9.0"
  }
}
