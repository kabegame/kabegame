# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
node_modules-*/
# PathQL client 生成物（deno task pathql:generate 重生成，不入库；外壳 package.json 入库）
/packages/kabegame-pathql-client/index.ts
dist-*
!dist-kabegame/
dist-kabegame/*
!dist-kabegame/.gitkeep
*.local

/.kabegame/release
/build

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# kabegame 的 tauri config 是动态生成的
# src-tauri/*/tauri.conf.json

# Tauri
target
# 历史隔离目录（target-22 / target-web），机制已退役，规则保留以忽略存量残留
target-*/
# 由 handlebars 生成
src-tauri/kabegame/capabilities/main.json
src-tauri/kabegame/tauri.conf.json
# apps/kabegame/index.html 由 handlebars 生成（见 index.html.handlebars）
apps/kabegame/index.html
src-tauri/*/gen/schemas/*
# 插件 permissions 下的 schema.json 由 tauri_plugin::Builder 在 cargo build 时生成
src-tauri-plugins/**/permissions/schemas/schema.json
src-tauri/kabegame/resources/bin/*
# 预置爬虫插件，由 crawler-plugins:package-to-resources 构建期生成，
# init_kgpg_plugin() 启动时移动进用户插件目录（见 PluginManager::seed_bundled_plugins）
src-tauri/kabegame/resources/plugins/
# Windows CEF runtime,由 os-plugin collectWindowsCefRuntime() 构建期生成
src-tauri/kabegame/resources/cef/
# macOS gen/CEFExample.app\Kabegame.app
/gen/

# bin/{platform}/ 根部是 os-plugin 构建期生成的运行时暂存：Linux/macOS 全部生成，
# Windows 的 dokan2/libwinpthread/libva 等部分 DLL 预置入库，生成的 FFmpeg/x264 DLL 忽略。
# bin/{platform}/{arch}/ 是第三方仓库编译产物（FFmpeg-build / x264-build /
# cef-build-{dev,prod} / rusty_v8-build），全部忽略，由 `deno task build:*` 复现。
# 架构目录名与 scripts/paths.ts 的 ARCH_DIR_NAMES 保持一致。
/bin/*/arm64/
/bin/*/x86_64/
/bin/windows/av*.dll
/bin/windows/swscale-*.dll
/bin/windows/swresample-*.dll
/bin/windows/libx264-*.dll
/bin/linux/
/bin/macos/
# Android 自建 V8 产物落在 bin/android/arm64/rusty_v8-build/，由
# `deno task build:v8` 复现，并由 mode-plugin 注入构建环境。
/bin/android/

# development data
/.kabegame/debug

# claude设计
/*.zip
/exports

# .cursor/

# /test/

# chromium checkout（build-chromium 的工作区，原仓库外 cefbuild）。
# 体积 ~60GB，不入库、也不做 submodule，由 `deno task build:chromium` 复现。
third/chromium/

# 一些临时文件
/ignore
tmp/
.tmp/

# 临时忽略 kamechan emotion 图片资源
apps/kabegame/public/kamechan/emotion*/**/*.png

# Astro docs
apps/docs/dist
apps/docs/.astro

__pycache__/
