import QtQuick
import QtQuick.Window
import "Plugin/@KB_QML_URI@" as KB

// 插件修订 @KB_PLUGIN_REVISION@ 的内容：找 Kabegame 的壁纸节点、铺满显示，把桌面上的鼠标发回 Kabegame。
// 不连 app IPC、不读 Kabegame 的设置、不认识壁纸类型（约定见 src-tauri/kabegame/src/wallpaper/manager/plasma/pipewire/ 与 manager/pointer_socket.rs）。
Item {
    id: root
    anchors.fill: parent

    KB.KabegameStreamFinder {
        id: finder
        screenName: root.Screen.name
        onSelectionChanged: console.log("[kabegame-wallpaper] r@KB_PLUGIN_REVISION@ screen=" + screenName + " node=" + nodeName + " serial=" + serial)
        onStatusChanged: console.log("[kabegame-wallpaper] r@KB_PLUGIN_REVISION@ pipewire=" + status)
    }

    KB.KabegamePointerForwarder {
        target: root
        inputPath: finder.inputPath
        slot: finder.slot
    }

    // 自己的消费端，不用 KPipeWire 的 PipeWireSourceItem（它在 NVIDIA 上会让 plasmashell 丢 GL 上下文，见 README「显示」）
    KB.KabegameStreamItem {
        anchors.fill: parent
        serial: finder.serial
        visible: finder.serial !== 0
        onStatusChanged: console.log("[kabegame-wallpaper] r@KB_PLUGIN_REVISION@ stream=" + status)
    }
}
