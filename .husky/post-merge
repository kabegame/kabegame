# 拉取/合并后自动重同步 third/ 子模块的 patch 系列。
#
# patch-manager 是 reset 模型:套用 = reset 回纯净基线 + 全量重放整个系列。所以这里
# 不必判断"新增了哪几个 patch、之前应用到第几个",也没有追加式约束要守——只要某个
# third-patches/<dir>/ 下有任何 patch 变动(新增/修改/删除/改名),对该目录整体重跑
# 一次即可,天然幂等。失败只告警,不阻断合并。
command -v deno >/dev/null 2>&1 || exit 0

changed=$(git diff --name-only ORIG_HEAD HEAD -- 'third-patches/*/*.patch' 2>/dev/null)
[ -z "$changed" ] && exit 0

echo "$changed" | awk -F/ '{ print $2 }' | sort -u | while read -r dir; do
  echo "[post-merge] third-patches/$dir 有 patch 变动,重同步: deno task patch $dir"
  deno task patch "$dir" ||
    echo "[post-merge] ⚠ deno task patch $dir 失败,请手动处理"
done
