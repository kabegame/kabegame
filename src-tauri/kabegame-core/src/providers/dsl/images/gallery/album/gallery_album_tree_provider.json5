{
    "namespace": "kabegame",
    "name": "gallery_album_tree_provider",
    "properties": {
        "album_id": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        "join": [
            {
                "kind": "INNER",
                "table": "album_images",
                "as": "tree_ai",
                "on": "images.id = tree_ai.image_id",
                "in_need": true
            },
            {
                "kind": "INNER",
                "table": "albums",
                "as": "tree_album",
                "on": "tree_album.id = tree_ai.album_id",
                "in_need": true
            }
        ],
        // 子树（含自身）的前缀区间，走 idx_albums_ancestor_path；`/` 的下一个字符是 `0`
        "where": "tree_album.ancestor_path >= (SELECT ancestor_path FROM albums WHERE id = ${properties.album_id}) AND tree_album.ancestor_path < (SELECT substr(ancestor_path, 1, length(ancestor_path) - 1) || '0' FROM albums WHERE id = ${properties.album_id})"
    },
    "resolve": {
        // 分页段（desc / x<N>x / 页号）必须自己接住：gallery_route 不处理分页，
        // 只落到下面的 .* 会以 `path not found` 收场（画册封面取 1 张就走这条）。
        // 与 gallery_album_provider 保持一致。
        "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
            "delegate": {
                "provider": "kabegame.gallery_desc_pagination_page_comb"
            },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        },
        ".*": {
            "delegate": { "provider": "gallery_route" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
