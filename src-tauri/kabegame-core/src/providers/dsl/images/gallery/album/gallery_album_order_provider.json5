{
    "namespace": "kabegame",
    "name": "gallery_album_order_provider",
    "query": {
        "order": [
            { "sql": "COALESCE(ai.\"order\", ai.rowid)", "order": "asc", "prepend": true },
            { "sql": "images.id", "order": "asc" }
        ]
    },
    "resolve": {
        "l([0-9]+)l": {
            "provider": "limit_leaf_provider",
            "properties": { "limit": "${capture[1]}" }
        }
    }
}
