{
    "namespace": "kabegame",
    "name": "gallery_route",
    "query": {
        "fields": [
            {
                "sql": "CAST(images.id AS TEXT)",
                "as": "id"
            },
            {
                "sql": "images.url",
                "as": "url",
                "in_need": true
            },
            {
                "sql": "images.local_path",
                "as": "local_path",
                "in_need": true
            },
            { 
                "sql": "images.plugin_id",
                "as": "plugin_id",
                "in_need": true
            },
            {
                "sql": "images.task_id",
                "as": "task_id",
                "in_need": true
            },
            {
                "sql": "images.surf_record_id",
                "as": "surf_record_id",
                "in_need": true
            },
            {
                "sql": "images.crawled_at",
                "as": "crawled_at",
                "in_need": true
            },
            {
                "sql": "images.metadata_id",
                "as": "metadata_id",
                "in_need": true
            },
            {
                "sql": "COALESCE(metadata_im.plugin_version, 0)",
                "as": "plugin_version",
                "in_need": true
            },
            {
                "sql": "COALESCE(NULLIF(images.thumbnail_path, ''), images.local_path)",
                "as": "thumbnail_path",
                "in_need": true
            },
            {
                "sql": "images.hash",
                "as": "hash",
                "in_need": true
            },
            {
                "sql": "CASE WHEN fav_ai.image_id IS NOT NULL THEN 1 ELSE 0 END",
                "as": "is_favorite",
                "in_need": true,
            },
            {
                "sql": "CASE WHEN hid_ai.image_id IS NOT NULL THEN 1 ELSE 0 END",
                "as": "is_hidden",
                "in_need": true
            },
            {
                "sql": "images.width",
                "as": "width",
                "in_need": true
            },
            {
                "sql": "images.height",
                "as": "height",
                "in_need": true
            },
            {
                "sql": "images.display_name",
                "as": "display_name",
                "in_need": true
            },
            {
                // as 必须是 "type" 而不是 "media_type":上游 images_root_provider 贡献
                // `images.*`,展开后已含一个 type 列。ImageInfo 的该字段是
                // `#[serde(rename = "type", alias = "media_type")]` —— 两个键名都吃,
                // 所以一旦 SELECT 里同时出现 type 和 media_type,反序列化就报
                // `duplicate field type`,整条 gallery 路径读不出数据。
                // 用同名 type 时,sql_executor 的 obj.insert 后写覆盖前者,
                // 而本 COALESCE 排在 images.* 之后,最终取到的正是补过默认值的结果。
                "sql": "COALESCE(images.type, 'image')",
                "as": "type",
                "in_need": true,
            },
            {
                "sql": "images.last_set_wallpaper_at",
                "as": "last_set_wallpaper_at",
                "in_need": true
            },
            {
                "sql": "images.size",
                "as": "size",
                "in_need": true
            },
            {
                "sql": "images.compatible_path",
                "as": "compatible_path",
                "in_need": true
            },
            {
                "sql": "images.post_url",
                "as": "post_url",
                "in_need": true
            }
        ],
        "order": [{ "sql": "images.crawled_at", "order": "asc" }],
        "join": [{
            "kind": "LEFT",
            "table": "album_images",
            "as": "fav_ai",
            "on": "images.id = fav_ai.image_id and fav_ai.album_id = ${global.favorite_album_id}",
            "in_need": true
        }, {
            "kind": "LEFT",
            "table": "album_images",
            "as": "hid_ai",
            "on": "images.id = hid_ai.image_id and hid_ai.album_id = ${global.hidden_album_id}",
            "in_need": true
        }, {
            "kind": "LEFT",
            "table": "metadata",
            "as": "metadata_im",
            "on": "images.metadata_id = metadata_im.id",
            "in_need": true
        }]
    },
    "note": "Gallery root. Each segment narrows the previous one; filters AND together. Combine two dimensions with `filter_comb`: gallery/plugin/patreon/filter_comb/media-type/image/x100x/1. `sort` is a sibling of `all`, not a child of it. `/desc` reverses the current order. `hide/` is a PREFIX excluding hidden images. Always end a collection path with /x<N>x/<page>.",
    "list": {
        "all": {
            "provider": "gallery_all_router"
        },
        "wallpaper-order": {
            "provider": "gallery_wallpaper_order_router"
        },
        "no-album": {
            "provider": "gallery_no_album_router"
        },
        "name": {
            "provider": "gallery_name_router"
        },
        "plugin": {
            "provider": "gallery_plugins_router"
        },
        "task": {
            "provider": "gallery_tasks_router"
        },
        "surf": {
            "provider": "gallery_surfs_router"
        },
        "media-type": {
            "provider": "gallery_media_type_router"
        },
        "date": {
            "provider": "gallery_dates_router"
        },
        "album": {
            "provider": "gallery_albums_router"
        },
        "hide": {
            "provider": "gallery_hide_router"
        },
        "search": {
            "provider": "gallery_search_router"
        },
        "sort": {
            "provider": "gallery_sort_router"
        },
        "by_id": {
            "provider": "gallery_by_id_router"
        },
        "by_path": {
            "provider": "gallery_by_path_router"
        },
        "by_compatible_path": {
            "provider": "gallery_by_compatible_path_router"
        },
        "by_thumbnail_path": {
            "provider": "gallery_by_thumbnail_path_router"
        },
        "by_url": {
            "provider": "gallery_by_url_router"
        },
        "by_hash": {
            "provider": "gallery_by_hash_router"
        },
        "bigger_crawler_time": {
            "provider": "gallery_bigger_crawler_time_router"
        },
        "size": {
            "provider": "gallery_size_router"
        },
        "aspect": {
            "provider": "gallery_aspect_router"
        }
    },
    "resolve": {
        "names": {
            "provider": "gallery_name_router"
        },
        "plugins": {
            "provider": "gallery_plugins_router"
        },
        "tasks": {
            "provider": "gallery_tasks_router"
        },
        "surfs": {
            "provider": "gallery_surfs_router"
        },
        "dates": {
            "provider": "gallery_dates_router"
        },
        "albums": {
            "provider": "gallery_albums_router"
        },
        "dimension": {
            "provider": "gallery_aspect_router"
        },
        "dimensions": {
            "provider": "gallery_aspect_router"
        }
    }
}
