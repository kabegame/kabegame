{
    "namespace": "kabegame",
    "name": "gallery_route",
    "query": {
        "fields": [
            {
                "sql": "CAST(images.id AS TEXT)",
                "as": "id"
            },
            {
                "sql": "images.url",
                "as": "url",
                "in_need": true
            },
            {
                "sql": "images.local_path",
                "as": "local_path",
                "in_need": true
            },
            { 
                "sql": "images.plugin_id",
                "as": "plugin_id",
                "in_need": true
            },
            {
                "sql": "images.task_id",
                "as": "task_id",
                "in_need": true
            },
            {
                "sql": "images.surf_record_id",
                "as": "surf_record_id",
                "in_need": true
            },
            {
                "sql": "images.crawled_at",
                "as": "crawled_at",
                "in_need": true
            },
            {
                "sql": "images.metadata_id",
                "as": "metadata_id",
                "in_need": true
            },
            {
                "sql": "images.image_metadata_id",
                "as": "image_metadata_id",
                "in_need": true
            },
            {
                "sql": "COALESCE(NULLIF(images.thumbnail_path, ''), images.local_path)",
                "as": "thumbnail_path",
                "in_need": true
            },
            {
                "sql": "images.hash",
                "as": "hash",
                "in_need": true
            },
            {
                // 收藏 / 隐藏标记用相关 EXISTS 而不是 LEFT JOIN album_images:每行一次
                // (album_id, image_id) 主键探测,与 JOIN 同价,且翻页不受收藏 / 隐藏集合大小影响
                // (不相关 IN 每条查询都要先物化整个集合,隐藏 50 万张时一页从 2.5ms 涨到 57ms)。
                // COUNT 包装下外层不读这两列,SQLite 不求值未用到的子查询列,探测随之省掉;
                // LEFT JOIN 无论用不用都会执行。主键保证 JOIN 最多匹配一行,两种写法行数与取值一致。
                "sql": "EXISTS (SELECT 1 FROM album_images AS fav_ex WHERE fav_ex.album_id = ${global.favorite_album_id} AND fav_ex.image_id = images.id)",
                "as": "is_favorite",
                "in_need": true,
            },
            {
                "sql": "EXISTS (SELECT 1 FROM album_images AS hid_ex WHERE hid_ex.album_id = ${global.hidden_album_id} AND hid_ex.image_id = images.id)",
                "as": "is_hidden",
                "in_need": true
            },
            {
                "sql": "images.width",
                "as": "width",
                "in_need": true
            },
            {
                "sql": "images.height",
                "as": "height",
                "in_need": true
            },
            {
                "sql": "images.display_name",
                "as": "display_name",
                "in_need": true
            },
            {
                // as 必须是 "type" 而不是 "media_type":ImageInfo 的该字段是
                // `#[serde(rename = "type", alias = "media_type")]` —— 两个键名都吃,
                // 下游列举 SQL(gallery_media_type_provider)也按 `sub.type` 读。
                "sql": "COALESCE(images.type, 'image')",
                "as": "type",
                "in_need": true,
            },
            {
                "sql": "images.last_set_wallpaper_at",
                "as": "last_set_wallpaper_at",
                "in_need": true
            },
            {
                "sql": "images.size",
                "as": "size",
                "in_need": true
            },
            {
                "sql": "images.compatible_path",
                "as": "compatible_path",
                "in_need": true
            },
            {
                "sql": "images.post_url",
                "as": "post_url",
                "in_need": true
            }
        ]
    },
    "note": "Gallery root. Each segment narrows the previous one; filters AND together. Combine two dimensions with `_kb_fc`: gallery/plugin/patreon/_kb_fc/media-type/image/_kb_x100x/1. `sort` is a sibling of `all`, not a child of it. `/_kb_desc` reverses the current order. `hide/` is a PREFIX excluding hidden images. Always end a collection path with /_kb_x<N>x/<page>. Global `_kb_` entries are resolved before this provider and are not listed as children.",
    // 路由表的静态维度没有 meta，省略 meta 以保留 None，避免透传成 JSON null。
    "list": {
        "${child.name}": {
            "delegate": { "provider": "gallery_router" },
            "child_var": "child",
            "provider": "${child.provider}"
        }
    },
    "resolve": {
        ".*": {
            "delegate": { "provider": "gallery_router" },
            "child_var": "child",
            "provider": "${child.provider}"
        }
    }
}
