{
    "namespace": "kabegame",
    "name": "gallery_surf_provider",
    "properties": {
        "host": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        "delegate": {
            "provider": "surf_provider",
            "properties": {
                "host": "${properties.host}"
            }
        }
    },
    "resolve": {
        "all|wallpaper-order|no-album|name|names|plugin|plugins|media-type|date|dates|search|sort|size|aspect|dimension|dimensions": {
            "delegate": { "provider": "gallery_route" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        },
    }
}
