{
    "namespace": "kabegame",
    "name": "gallery_album_root_kind_router",
    "properties": {
        "kinds": { "type": "string", "default": "", "optional": false }
    },
    "resolve": {
        "album_page_(normal|label|local_folder)_x([1-9][0-9]*)x_([1-9][0-9]*)": {
            "provider": "gallery_album_page_provider",
            "properties": {
                "section": "${capture[1]}",
                "parent_id": "",
                "page": "${capture[3]}",
                "page_size": "${capture[2]}",
                "kinds": "${properties.kinds}"
            }
        }
    }
}
