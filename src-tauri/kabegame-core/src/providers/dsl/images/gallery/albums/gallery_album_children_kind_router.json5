{
    "namespace": "kabegame",
    "name": "gallery_album_children_kind_router",
    "properties": {
        "parent_id": { "type": "string", "default": "", "optional": false },
        "kinds": { "type": "string", "default": "", "optional": false }
    },
    "resolve": {
        "album_page_x([1-9][0-9]*)x_([1-9][0-9]*)": {
            "provider": "gallery_album_page_provider",
            "properties": {
                "section": "children",
                "parent_id": "${properties.parent_id}",
                "page": "${capture[2]}",
                "page_size": "${capture[1]}",
                "kinds": "${properties.kinds}"
            }
        }
    }
}
