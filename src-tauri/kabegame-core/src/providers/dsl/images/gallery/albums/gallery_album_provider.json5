{
    "namespace": "kabegame",
    "name": "gallery_album_provider",
    "properties": {
        "album_id": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        // 进入子画册时先清掉父画册的同名条件，否则 gallery/album/<父>/<子> 叠成
        // `ai.album_id = 父 AND ai.album_id = 子` 恒为空（where_clear 按子串匹配，带上 " =" 避免误清
        // no-album 的 `nai.album_id <>` 与标签搜索的 `lai.album_id AND`）
        "where_clear": ["ai.album_id ="],
        "where": "ai.album_id = ${properties.album_id}"
    },
    "list": {
        "${out.id}": {
            "sql": "SELECT id, name, created_at, parent_id, type, sync_folder, folder_status, ancestor_path, label_key, label_path FROM albums WHERE parent_id = ${properties.album_id} ORDER BY name_language_rank(name_language_bucket(COALESCE(name, ''))) ASC, name COLLATE NOCASE ASC, created_at ASC",
            "data_var": "out",
            "provider": "gallery_album_provider",
            "properties": {
                "album_id": "${out.id}"
            },
            "meta": {
                "kind": "album",
                "data": {
                    "id": "${out.id}",
                    "name": "${out.name}",
                    "createdAt": "${out.created_at}",
                    "parentId": "${out.parent_id}",
                    "type": "${out.type}",
                    "syncFolder": "${out.sync_folder}",
                    "folderStatus": "${out.folder_status}",
                    "labelKey": "${out.label_key}",
                    "labelPath": "${out.label_path}"
                }
            }
        }
    },
    "resolve": {
        "album_page_x([1-9][0-9]*)x_([1-9][0-9]*)": {
            "provider": "gallery_album_page_provider",
            "properties": {
                "section": "children",
                "parent_id": "${properties.album_id}",
                "page": "${capture[2]}",
                "page_size": "${capture[1]}",
                "kinds": ""
            }
        },
        "kind_((?:normal|label|label_dir|local_folder)(?:,(?:normal|label|label_dir|local_folder))*)": {
            "provider": "gallery_album_children_kind_router",
            "properties": {
                "parent_id": "${properties.album_id}",
                "kinds": "${capture[1]}"
            }
        },
        "image-only": {
            "provider": "gallery_album_media_type_provider",
            "properties": { "kind": "image" }
        },
        "video-only": {
            "provider": "gallery_album_media_type_provider",
            "properties": { "kind": "video" }
        },
        "bigger_order": { "provider": "gallery_album_bigger_order_router" },
        "id_([^/]+)": {
            "provider": "gallery_by_id_provider",
            "properties": { "image_id": "${capture[1]}" }
        },
        "filter_comb": {
            "provider": "gallery_filter_comb"
        },
        "all|wallpaper-order|no-album|name|names|plugin|plugins|media-type|date|dates|search|sort|size|aspect|dimension|dimensions": {
            "delegate": { "provider": "gallery_route" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        },
        "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
            "delegate": {
                "provider": "kabegame.gallery_desc_pagination_page_comb"
            },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        },
        "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}": {
            "provider": "gallery_album_provider",
            "properties": { "album_id": "${capture[0]}" }
        }
    }
}
