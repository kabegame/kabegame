{
    "namespace": "kabegame",
    "name": "gallery_album_page_provider",
    "properties": {
        "section": { "type": "string", "default": "children", "optional": false },
        "parent_id": { "type": "string", "default": "", "optional": false },
        "page": { "type": "number", "default": 1, "optional": false },
        "kinds": { "type": "string", "default": "", "optional": false }
    },
    "list": {
        "${album.id}": {
            "sql": "SELECT albums.id, albums.name, albums.created_at, albums.parent_id, albums.type, albums.sync_folder, albums.folder_status, albums.ancestor_path, albums.sync_mode, albums.label_key, albums.label_path FROM albums WHERE ((((${properties.section} = 'children') AND albums.parent_id = ${properties.parent_id}) OR ((${properties.section} = 'normal') AND albums.parent_id IS NULL AND albums.type = 'normal' AND albums.id NOT IN (${global.favorite_album_id}, ${global.hidden_album_id})) OR ((${properties.section} = 'label') AND albums.parent_id IS NULL AND albums.type IN ('label', 'label_dir')) OR ((${properties.section} = 'local_folder') AND albums.type = 'local_folder' AND (albums.parent_id IS NULL OR NOT EXISTS (SELECT 1 FROM albums parent WHERE parent.id = albums.parent_id AND parent.type = 'local_folder')))) AND ((${properties.section} != 'children') OR CASE (SELECT type FROM albums parent WHERE parent.id = ${properties.parent_id}) WHEN 'normal' THEN albums.type = 'normal' WHEN 'local_folder' THEN albums.type = 'local_folder' ELSE albums.type IN ('label', 'label_dir') END) AND (${properties.kinds} = '' OR instr(',' || ${properties.kinds} || ',', ',' || albums.type || ',') > 0)) ORDER BY name_language_rank(name_language_bucket(COALESCE(albums.name, ''))) ASC, albums.name COLLATE NOCASE ASC, albums.id ASC LIMIT 100 OFFSET (${properties.page} - 1) * 100",
            "data_var": "album",
            "provider": "gallery_album_provider",
            "properties": { "album_id": "${album.id}" },
            "meta": "${album}"
        }
    }
}
