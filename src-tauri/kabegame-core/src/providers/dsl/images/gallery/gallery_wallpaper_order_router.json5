{
    "namespace": "kabegame",
    "name": "gallery_wallpaper_order_router",
    "note": "Filter to images that have been set as wallpaper at least once. Continue with global `_kb_fc` to add another dimension, or append _kb_desc/_kb_x<N>x/<page>; sorting is still controlled explicitly by sort.",
    // 7c S5: programmatic GalleryWallpaperOrderRouter 迁 DSL。
    // 仅取被设过壁纸的图；排序由 gallery_sort_router 独立处理。
    "query": {
        "where": "images.last_set_wallpaper_at IS NOT NULL"
    }
}
