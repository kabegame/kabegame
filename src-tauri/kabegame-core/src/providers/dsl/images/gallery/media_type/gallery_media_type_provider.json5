{
    "namespace": "kabegame",
    "name": "gallery_media_type_provider",
    "properties": {
        "kind": { "type": "string", "default": "image", "optional": false }
    },
    // WHERE 按 kind 分支: image = 非 video 媒体, video = video / video/* 媒体。
    // 用 CASE 单条 SQL 同时表达两分支, kind 作为 bind 参数。
    "query": {
        "where": "CASE ${properties.kind} WHEN 'video' THEN (LOWER(COALESCE(images.type, '')) = 'video' OR LOWER(COALESCE(images.type, '')) LIKE 'video/%') ELSE NOT (LOWER(COALESCE(images.type, '')) = 'video' OR LOWER(COALESCE(images.type, '')) LIKE 'video/%') END"
    },
    "list": {
        "${fmt.format}": {
            // 列名统一为 type（原 media_type），读 gallery_route 投影的 `type` 列。
            // 分组计数 count 随列举带出，list(with_count=false) 即可拿到每种格式的行数。
            "sql": "SELECT format, cnt AS count FROM (SELECT LOWER(SUBSTR(COALESCE(sub.type, ''), INSTR(COALESCE(sub.type, ''), '/') + 1)) AS format, COUNT(*) AS cnt FROM (${composed}) AS sub WHERE LOWER(COALESCE(sub.type, '')) LIKE '%/%' GROUP BY format) WHERE format != '' AND cnt > 0 ORDER BY format ASC",
            "data_var": "fmt",
            "provider": "gallery_media_format_provider",
            "properties": {
                "format": "${fmt.format}"
            },
            "meta": {
                "format": "${fmt.format}",
                "count": "${fmt.count}"
            }
        }
    },
    "resolve": {
        // 兜底: 格式段不靠动态枚举也能路由(空上下文命中数为 0, 不是 not found)。
        // resolve 按声明顺序匹配, 本条必须在 desc/分页之后; 字符集排除 `_`,
        // 结构上就命不中媒体格式；组合与分页由全局 `_kb_fc` / `_kb_x<N>x` 接走。
        "([0-9]*[a-z][a-z0-9.+-]*)": {
            "alias": "format",
            "provider": "gallery_media_format_provider",
            "properties": { "format": "${capture[1]}" }
        },
    }
}
