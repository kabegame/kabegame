{
    "namespace": "kabegame",
    "name": "gallery_media_type_provider",
    // 图片：type_glob = '*'，type_not_glob = 'video/*'（默认值）。视频：type_glob = 'video/*'，type_not_glob = ''。
    "properties": {
        "type_glob": { "type": "string", "default": "*", "optional": false },
        "type_not_glob": { "type": "string", "default": "video/*", "optional": false }
    },
    // type 已规范化，video/* 归视频，x-wpe/video 仍归图片。
    // 模式串直接绑定进 GLOB：视频的前缀能走 idx_images_type，图片的 `*` 不走索引、沿排序索引取满即停，见 RULES.md。
    "query": {
        "where": "images.type GLOB ${properties.type_glob} AND images.type NOT GLOB ${properties.type_not_glob}"
    },
    "list": {
        "${fmt.format}": {
            // 列名统一为 type（原 media_type），读 gallery_route 投影的 `type` 列。
            // 分组计数 count 随列举带出，list(with_count=false) 即可拿到每种格式的行数。
            "sql": "SELECT SUBSTR(sub.type, INSTR(sub.type, '/') + 1) AS format, COUNT(*) AS count FROM (${composed}) AS sub GROUP BY format ORDER BY format ASC",
            "data_var": "fmt",
            "provider": "gallery_media_format_provider",
            "properties": {
                "format": "${fmt.format}"
            },
            "meta": {
                "format": "${fmt.format}",
                "count": "${fmt.count}"
            }
        }
    },
    "resolve": {
        // 兜底: 格式段不靠动态枚举也能路由(空上下文命中数为 0, 不是 not found)。
        // resolve 按声明顺序匹配, 本条必须在 desc/分页之后; 字符集排除 `_`,
        // 结构上就命不中媒体格式；组合与分页由全局 `_kb_fc` / `_kb_x<N>x` 接走。
        "([0-9]*[a-z][a-z0-9.+-]*)": {
            "alias": "format",
            "provider": "gallery_media_format_provider",
            "properties": { "format": "${capture[1]}" }
        },
    }
}
