{
    "namespace": "kabegame",
    "name": "gallery_search_display_name_query_provider",
    "properties": {
        "query": { "type": "string", "default": "", "optional": false }
    },
    // SQL 转义 LIKE 元字符 % / _ / \\ 后包裹 % 通配; ESCAPE '\' 关掉 LIKE 默认对 \\ 的处理。
    // ${properties.query} 在 REPLACE 内只 bind 一次, 多层 REPLACE 都作用在同一参数上。
    // 列与模式都不包 LOWER：LIKE 默认就不区分 ASCII 大小写，而未编译 ICU 的 LOWER 也只折叠 ASCII，
    // 结果完全相同，包了只会把整列文本逐行复制一遍（四维度搜索 COUNT 实测多出约 25%）。其余 LIKE 搜索维度同理。
    "query": {
        "where": "images.display_name LIKE '%' || REPLACE(REPLACE(REPLACE(${properties.query}, '\\', '\\\\'), '%', '\\%'), '_', '\\_') || '%' ESCAPE '\\'"
    },
    // list / resolve 都委派 gallery_route — 让搜索结果可以继续走 all/_kb_x<N>x/N 等分页或
    "resolve": {
        ".*": {
            "delegate": { "provider": "gallery_route" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
