{
    "namespace": "kabegame",
    "name": "gallery_search_metadata_query_provider",
    "properties": {
        "query": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        // 字典 + 映射：先在去重后的词条上做 LIKE（与图片数无关），再按 (term_id, metadata_id) 主键取 metadata 集合。
        // 必须写成嵌套 IN：JOIN 写法在没有统计信息时会先扫整张映射表（实测 1.1s，嵌套 IN 为 0.16s）。
        // metadata_id 可能为 NULL：先判 IS NOT NULL，否则 `~not` 下 NULL IN (...) 为 NULL，没有元数据的图会被整批排除。
        "where": "images.metadata_id IS NOT NULL AND images.metadata_id IN (SELECT metadata_id FROM metadata_search_terms WHERE term_id IN (SELECT id FROM search_terms WHERE text LIKE '%' || REPLACE(REPLACE(REPLACE(${properties.query}, '\\', '\\\\'), '%', '\\%'), '_', '\\_') || '%' ESCAPE '\\'))"
    },
    "resolve": {
        ".*": {
            "delegate": { "provider": "gallery_route" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
