{
    "namespace": "kabegame",
    "name": "gallery_plugins_router",
    "note": "Filter by crawler plugin. List this node to get the real plugin ids in this library (ids are lowercase slugs). Then: gallery/plugin/<id>/desc/x100x/1",
    "list": {
        "${plugin.name}": {
            "delegate": {
                "provider": "plugins_provider"
            },
            "child_var": "plugin",
            "provider": "gallery_plugin_router",
            "properties": {
                "plugin_id": "${plugin.name}"
            },
            "meta": "${plugin.meta.plugin}"
        }
    },
    "resolve": {
        "([a-z][a-z0-9_-]*)": {
            "alias": "plugin",
            "provider": "gallery_plugin_router",
            "properties": {
                "plugin_id": "${capture[1]}"
            }
        }
    }
}
