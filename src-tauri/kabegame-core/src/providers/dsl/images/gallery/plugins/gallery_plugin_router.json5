{
    "namespace": "kabegame",
    "name": "gallery_plugin_router",
    "note": "Images from the selected crawler plugin. Continue with filter_comb to add another dimension, extend for the plugin-defined entry tree, or desc/x<N>x/<page> for a collection. A syntactically valid but uninstalled plugin id resolves to an empty set.",
    "properties": {
        "plugin_id": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        "delegate": {
            "provider": "plugin_provider",
            "properties": { "plugin_id": "${properties.plugin_id}" }
        }
    },
    "resolve": {
        "filter_comb": {
            "provider": "gallery_filter_comb"
        },
        "extend": {
            "provider": "plugin_entry_provider",
            "properties": { "plugin_id": "${properties.plugin_id}" }
        },
        "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
            "delegate": {
                "provider": "kabegame.gallery_desc_pagination_page_comb"
            },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
