{
    "namespace": "kabegame",
    "name": "gallery_plugin_router",
    "note": "Images from the selected crawler plugin. Continue with global `_kb_fc` to add another dimension, extend for the plugin-defined entry tree, or _kb_desc/_kb_x<N>x/<page> for a collection. A syntactically valid but uninstalled plugin id resolves to an empty set.",
    "properties": {
        "plugin_id": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        "delegate": {
            "provider": "plugin_provider",
            "properties": { "plugin_id": "${properties.plugin_id}" }
        }
    },
    "resolve": {
        "extend": {
            "provider": "plugin_entry_provider",
            "properties": { "plugin_id": "${properties.plugin_id}" }
        },
    }
}
