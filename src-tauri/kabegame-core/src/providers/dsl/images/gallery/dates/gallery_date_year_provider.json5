{
    "namespace": "kabegame",
    "name": "gallery_date_year_provider",
    "properties": {
        "year": { "type": "string", "default": "", "optional": false }
    },
    // 年节点自身过滤年份: date/2024y 单独作过滤维度(高级查询原子)时必须真实收窄;
    // 月/日子节点的 %Y-%m(-%d) 条件与之 AND 后语义不变(冗余但无害)。
    // CAST 同 shared/year_provider: year 模板值按数值绑参, 而 strftime 返回 TEXT,
    // TEXT = INTEGER 在 SQLite 恒假。
    "query": {
        "where": "strftime('%Y', crawled_at_seconds(images.crawled_at), 'unixepoch') = CAST(${properties.year} AS TEXT)"
    },
    // list: desc 静态 + 动态月份 + 默认分页静态 (与 programmatic 同; 用户在年下既可看月也可直接翻页)
    "list": {
        "${out.meta.mm}m": {
            "delegate": {
                "provider": "year_provider",
                "properties": {
                    "year": "${properties.year}"
                }
            },
            "child_var": "out",
            "provider": "gallery_date_month_provider",
            "properties": {
                "year_month": "${properties.year}-${out.meta.mm}"
            }
        }
    },
    "resolve": {
        "filter_comb": {
            "provider": "gallery_filter_comb"
        },
        "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
            "alias": "paginate",
            "delegate": {
                "provider": "kabegame.gallery_desc_pagination_page_comb"
            },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        },
        // 兜底: 月份段不靠动态枚举也能路由(空上下文命中数为 0, 不是 not found)。
        "([0-9]{2})m": {
            "alias": "month",
            "provider": "gallery_date_month_provider",
            "properties": { "year_month": "${properties.year}-${capture[1]}" }
        },
    }
}
