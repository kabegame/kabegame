{
    "namespace": "kabegame",
    "name": "gallery_by_compatible_path_router",
    "note": "Look up one image by its compatibility-copy path. Pass the exact stored compatible_path as the next single PathQL segment; a missing value returns an empty result.",
    "resolve": {
        "(.+)": {
            "provider": "gallery_by_compatible_path_provider",
            "properties": { "path": "${capture[1]}" }
        }
    }
}
