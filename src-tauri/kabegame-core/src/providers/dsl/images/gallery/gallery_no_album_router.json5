{
    "namespace": "kabegame",
    "name": "gallery_no_album_router",
    "note": "Filter to images not assigned to a regular album. Favorite-only images are intentionally included, while hidden-album membership is ignored; continue with filter_comb, desc, or pagination.",
    "query": {
        // LEFT JOIN album_images 会按画册归属数扇出行（收藏且在其他画册的图片被 is_favorite 全部放行），改用 NOT EXISTS 保证每图至多一行
        "where": "is_favorite or NOT EXISTS (SELECT 1 FROM album_images nai WHERE nai.image_id = images.id AND nai.album_id <> ${global.hidden_album_id})"
    },
    "resolve": {
        "filter_comb": {
            "provider": "gallery_filter_comb"
        },
        "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
            "delegate": {
                "provider": "kabegame.gallery_desc_pagination_page_comb"
            },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
