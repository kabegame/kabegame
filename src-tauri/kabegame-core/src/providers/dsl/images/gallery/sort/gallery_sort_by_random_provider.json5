{
    "namespace": "kabegame",
    "name": "gallery_sort_by_random_provider",
    "properties": {
        "seed": { "type": "string", "optional": false }
    },
    "query": {
        "order": [{ "sql": "kb_rand(${properties.seed}, images.id)", "order": "asc", "clear": "all" }]
    },
    "resolve": {
        "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
            "delegate": {
                "provider": "kabegame.gallery_desc_pagination_page_comb"
            },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    },
    "note": "Seeded random shuffle: .../sort/random-12345/x100x/1. Same seed = same permutation (stable pagination); different seed = unrelated permutation. Append /desc before the page for the reversed sequence."
}
