{
    "namespace": "kabegame",
    "name": "gallery_sort_by_random_provider",
    "properties": {
        "seed": { "type": "string", "optional": false }
    },
    "query": {
        "order": [
            { "sql": "kb_rand(${properties.seed}, images.id)", "order": "asc" },
            { "sql": "images.id", "order": "asc" }
        ]
    },
    "note": "Seeded random shuffle: .../sort/random-12345/_kb_x100x/1. Same seed = same permutation (stable pagination); different seed = unrelated permutation. Append /_kb_desc before the page for the reversed sequence."
}
