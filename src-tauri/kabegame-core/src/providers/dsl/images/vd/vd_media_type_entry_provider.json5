{
    "namespace": "kabegame",
    "name": "vd_media_type_entry_provider",
    "properties": {
        "kind": { "type": "string", "default": "image", "optional": false }
    },
    "query": {
        "delegate": {
            "provider": "gallery_media_type_provider",
            "properties": { "kind": "${properties.kind}" }
        }
    },
    "list": {
        "${format.name}": {
            "alias": "format",
            "delegate": {
                "provider": "gallery_media_type_provider",
                "properties": { "kind": "${properties.kind}" }
            },
            "child_var": "format",
            "provider": "vd_media_format_entry_provider",
            "properties": { "format": "${format.meta.format}" },
            "meta": "${format.meta}"
        },
        "${page.name}": {
            "alias": "page",
            "delegate": {
                "provider": "page_size_provider",
                "properties": { "page_size": 100 }
            },
            "child_var": "page",
            "provider": "query_page_provider",
            "properties": {
                "page_size": 100,
                "page_num": "${page.meta.page_num}"
            },
            "meta": "${page.meta}"
        }
    },
    "resolve": {
        // 格式名直接解析（同 gallery_media_type_provider 的兜底正则），不经过动态 list 反查
        "([0-9]*[a-z][a-z0-9.+-]*)": {
            "provider": "vd_media_format_entry_provider",
            "properties": { "format": "${capture[1]}" }
        },
        // 页号直接解析，不经过动态 list 反查（反查要先跑一遍页号列举 SQL）
        "([1-9][0-9]*)": {
            "provider": "query_page_provider",
            "properties": {
                "page_size": 100,
                "page_num": "${capture[1]}"
            }
        }
    }
}
