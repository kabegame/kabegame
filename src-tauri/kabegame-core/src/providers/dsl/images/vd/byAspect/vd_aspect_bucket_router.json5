{
    "namespace": "kabegame",
    "name": "vd_aspect_bucket_router",
    // 各语言「按尺寸」目录的友好名称落到这里，带具体区间的上下界，含义同 aspect_range_provider。
    "properties": {
        "min_w": { "type": "number", "default": 0, "min": 0, "optional": false },
        "min_h": { "type": "number", "default": 1, "min": 0, "optional": false },
        "max_w": { "type": "number", "default": 1, "min": 0, "optional": false },
        "max_h": { "type": "number", "default": 0, "min": 0, "optional": false }
    },
    "query": {
        "delegate": {
            "provider": "aspect_range_provider",
            "properties": {
                "min_w": "${properties.min_w}",
                "min_h": "${properties.min_h}",
                "max_w": "${properties.max_w}",
                "max_h": "${properties.max_h}"
            }
        }
    },
    // 分页子项与 vd_aspect_unknown_router 相同，改一处要同步另一处。
    "list": {
        "${page.name}": {
            "child_var": "page",
            "delegate": {
                "provider": "page_size_provider",
                "properties": { "page_size": 100 }
            },
            "provider": "query_page_provider",
            "properties": {
                "page_size": 100,
                "page_num": "${page.meta.page_num}"
            }
        }
    },
    "resolve": {
        "x([1-9][0-9]*)x": {
            "provider": "gallery_paginate_router",
            "properties": { "page_size": "${capture[1]}" }
        },
        "([1-9][0-9]*)": {
            "provider": "query_page_provider",
            "properties": {
                "page_size": 100,
                "page_num": "${capture[1]}"
            }
        }
    }
}
