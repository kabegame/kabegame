{
    "namespace": "kabegame",
    "name": "images_root_provider",
    "query": {
        "fields": ["images.*"],
    },
    "list": {
        "gallery": { "provider": "gallery_route" },
        "vd": { "provider": "vd_root_router" },
        // 只在 `~~` 之后有意义 —— 边界把 provider 视角切回本 schema 根,所以挂在这里。
        // 用法见 rank_provider 的注释。
        "rank": { "provider": "rank_provider" }
    },
    "resolve": {
        "x([1-9][0-9]*)x": {
            "alias": "page_size",
            "delegate": { "provider": "image_basic_provider" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        },
        "id_([^/]+)": {
            "alias": "id",
            "delegate": { "provider": "image_basic_provider" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
