{
    "namespace": "kabegame",
    "name": "run_configs_plugin_provider",
    "properties": {
        "plugin_id": { "type": "string", "default": "", "optional": false }
    },
    "query": { "where": "run_configs.plugin_id = ${properties.plugin_id}" },
    "resolve": {
        ".*": {
            "delegate": { "provider": "run_configs_filter_router" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
