{
    "namespace": "kabegame", "name": "run_configs_sort_last_provider",
    "query": { "order": [{ "sql": "rc_last.start_time", "order": "asc", "prepend": true }] },
    "resolve": { "desc": { "provider": "run_configs_sort_last_desc_provider" }, ".*": {
        "delegate": { "provider": "run_configs_filter_router" },
        "child_var": "child",
        "provider": "${child.provider}",
        "meta": "${child.meta}"
    } }
}
