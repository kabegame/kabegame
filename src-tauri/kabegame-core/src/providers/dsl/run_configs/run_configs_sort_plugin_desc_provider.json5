{
    "namespace": "kabegame", "name": "run_configs_sort_plugin_desc_provider",
    "query": { "order": [{ "sql": "run_configs.plugin_id", "order": "desc", "prepend": true }] },
    "resolve": { ".*": {
        "delegate": { "provider": "run_configs_filter_router" },
        "child_var": "child",
        "provider": "${child.provider}",
        "meta": "${child.meta}"
    } }
}
