{
    "namespace": "kabegame", "name": "run_configs_sort_next_desc_provider",
    "query": { "order": [
        { "sql": "run_configs.schedule_planned_at", "order": "desc", "prepend": true },
        { "sql": "CASE WHEN run_configs.schedule_planned_at IS NULL THEN 1 ELSE 0 END", "order": "asc", "prepend": true }
    ] },
    "resolve": { ".*": {
        "delegate": { "provider": "run_configs_filter_router" },
        "child_var": "child",
        "provider": "${child.provider}",
        "meta": "${child.meta}"
    } }
}
