{
    "namespace": "kabegame",
    "name": "tasks_plugin_provider",
    "properties": {
        "plugin_id": { "type": "string", "default": "", "optional": false }
    },
    "query": { "where": "tasks.plugin_id = ${properties.plugin_id}" },
    "resolve": {
        ".*": {
            "delegate": { "provider": "tasks_filter_router" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
