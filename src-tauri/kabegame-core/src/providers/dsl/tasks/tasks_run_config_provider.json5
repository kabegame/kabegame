{
    "namespace": "kabegame",
    "name": "tasks_run_config_provider",
    "properties": {
        "run_config_id": { "type": "string", "default": "", "optional": false }
    },
    "query": { "where": "tasks.run_config_id = ${properties.run_config_id}" },
    "resolve": {
        ".*": {
            "delegate": { "provider": "tasks_filter_router" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
