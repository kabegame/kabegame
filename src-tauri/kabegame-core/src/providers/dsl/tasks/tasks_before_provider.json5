{
    "namespace": "kabegame",
    "name": "tasks_before_provider",
    "properties": {
        "ts": { "type": "number", "default": 0, "optional": false },
        "id": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        "where": "(COALESCE(tasks.start_time, 0) < ${properties.ts} OR (COALESCE(tasks.start_time, 0) = ${properties.ts} AND tasks.id < ${properties.id}))"
    },
    "resolve": {
        ".*": {
            "delegate": { "provider": "tasks_filter_router" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
