{
    "namespace": "kabegame",
    "name": "tasks_plugin_search_provider",
    "properties": {
        "q": { "type": "string", "default": "", "optional": false }
    },
    "query": { "where": "instr(lower(tasks.plugin_id), lower(${properties.q})) > 0" },
    "resolve": {
        ".*": {
            "delegate": { "provider": "tasks_filter_router" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
