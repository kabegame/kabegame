{
    "namespace": "kabegame",
    "name": "dates_provider",
    // 本层是年; apply_query 给上游加 crawled_at ASC 排序基线。
    "query": {
        "order": [{ "sql": "images.crawled_at", "order": "asc" }]
    },
    "list": {
        // 从 composed 按年分组 (DESC, 最近的先)，一次扫描同时给出每年行数 count（画廊过滤树直接读它）。
        // ${composed} 已带 gallery_route fields/joins。
        "${out.year}": {
            "sql": "SELECT strftime('%Y', crawled_at_seconds(sub.crawled_at), 'unixepoch', 'localtime') AS year, COUNT(*) AS count FROM (${composed}) AS sub GROUP BY year HAVING year IS NOT NULL ORDER BY year DESC",
            "data_var": "out",
            "meta": "${out}"
        }
    },
}
