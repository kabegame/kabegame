{
    "namespace": "kabegame",
    "name": "month_provider",
    "properties": {
        "year_month": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        "where": "strftime('%Y-%m', crawled_at_seconds(images.crawled_at), 'unixepoch', 'localtime') = ${properties.year_month}"
    },
    "list": {
        "${out.dd}": {
            // 按日分组，一次扫描同时给出每日行数 count。
            "sql": "SELECT substr(strftime('%Y-%m-%d', crawled_at_seconds(sub.crawled_at), 'unixepoch', 'localtime'), 9, 2) AS dd, COUNT(*) AS count FROM (${composed}) AS sub GROUP BY dd HAVING dd IS NOT NULL ORDER BY dd DESC",
            "data_var": "out",
            "meta": "${out}"
        },
    }
}
