{
    "namespace": "kabegame",
    "name": "albums_child_count_provider",
    "properties": {
        "album_id": { "type": "string", "default": "", "optional": false }
    },
    "query": {
        // 列举项叠在分页节点的 composed 上计数：清掉层级（parent/<id>、roots）与 search 谓词，
        // 换成「父 = 本项」；album_kind 条件保留，所以子画册数与树里展开后看到的一致。
        "where_clear": ["albums.parent_id", "instr(LOWER(albums.name)"],
        "where": "albums.parent_id = ${properties.album_id}"
    }
}
