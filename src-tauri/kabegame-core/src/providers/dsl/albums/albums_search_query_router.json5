{
    "namespace": "kabegame",
    "name": "albums_search_query_router",
    "properties": {
        "query": { "type": "string", "default": "", "optional": false },
        "kinds": { "type": "string", "default": "", "optional": false }
    },
    "resolve": {
        "subpage_([1-9][0-9]*)": {
            "provider": "albums_search_page_provider",
            "properties": { "query": "${properties.query}", "page": "${capture[1]}", "kinds": "${properties.kinds}" }
        },
        "kind_((?:normal|label|label_dir|local_folder)(?:,(?:normal|label|label_dir|local_folder))*)": {
            "provider": "albums_search_query_router",
            "properties": { "query": "${properties.query}", "kinds": "${capture[1]}" }
        }
    }
}
