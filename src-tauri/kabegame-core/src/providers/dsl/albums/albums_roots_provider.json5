{
    "namespace": "kabegame",
    "name": "albums_roots_provider",
    "note": "Forest roots: albums without a parent, plus albums whose parent belongs to another forest (a local_folder album nested under a normal album). System albums (favorite / hidden) are excluded; they form their own section.",
    "query": {
        "join": [{
            "kind": "LEFT",
            "table": "albums",
            "as": "parent_album",
            "on": "parent_album.id = albums.parent_id",
            "in_need": true
        }],
        // 同一森林：类型相同，或同属标签森林（label / label_dir）。
        // 整条都引用 albums.parent_id，便于 parent/<id> 与列举项计数按嵌套目录模式整条清除。
        "where_clear": ["albums.parent_id"],
        "where": "(albums.parent_id IS NULL OR (parent_album.type <> albums.type AND NOT (parent_album.type IN ('label', 'label_dir') AND albums.type IN ('label', 'label_dir')))) AND albums.id NOT IN (${global.favorite_album_id}, ${global.hidden_album_id})"
    },
    "resolve": {
        ".*": {
            "delegate": { "provider": "albums_filter_router" },
            "child_var": "child",
            "provider": "${child.provider}",
            "meta": "${child.meta}"
        }
    }
}
