{
    "namespace": "kabegame",
    "name": "albums_page_provider",
    "note": "One page of the albums selected by the preceding filter segments, sorted by name. List with counts: each entry's total is its direct child album count under the same album_kind filters.",
    "properties": {
        "page": { "type": "number", "default": 1, "optional": false },
        "page_size": { "type": "number", "default": 100, "min": 1, "optional": true }
    },
    "query": {
        // 追加而非 clear：search 贡献的相关度排序保持在最前。
        "order": [
            { "sql": "name_language_rank(name_language_bucket(COALESCE(albums.name, '')))", "order": "asc" },
            { "sql": "albums.name COLLATE NOCASE", "order": "asc" },
            { "sql": "albums.id", "order": "asc" }
        ]
    },
    "list": {
        // 过滤全部来自上游段折叠出的 ${composed}；本节点只切页（RULES §4.2：列举分页写在 list.sql）。
        "${album.id}": {
            "sql": "SELECT * FROM (${composed}) AS page LIMIT ${properties.page_size} OFFSET (${properties.page} - 1) * ${properties.page_size}",
            "data_var": "album",
            "provider": "albums_child_count_provider",
            "properties": { "album_id": "${album.id}" },
            "meta": "${album}"
        }
    }
}
