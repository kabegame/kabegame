{
  "identifier": "wpe-web-capability",
  "description": "Desktop WPE web wallpaper page (file:// main frame): pull state and listen events only",
  "local": false,
  "windows": ["wallpaper"],
  "remote": {
    "urls": ["file:///*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "wpe-web"
  ]
}
