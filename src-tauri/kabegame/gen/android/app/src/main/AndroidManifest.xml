<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 读取媒体文件权限，没有这个权限就不能扫图片 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.kabegame"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- 添加文件关联的 intent-filter -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                
                <!-- 通过文件扩展名匹配 -->
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.kgpg" />
                
                <!-- 通过 MIME 类型匹配 -->
                <data android:mimeType="application/x-kabegame-kgpg" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            
            <!-- 支持通过文件管理器打开（content:// URI） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-kabegame-kgpg" />
            </intent-filter>
            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-kabegame-kgpg" />
                <data android:pathPattern=".*\\.kgpg" />
            </intent-filter>
            
            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <activity
            android:name=".SurfActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!--
            WebView 爬虫宿主：只当 wry 的宿主，页面由 CrawlerHost 停靠到主界面下，Activity 自己
            在第一帧之前退到后台。每个实例单独成栈（documentLaunchMode="always"）。
            不能 excludeFromRecents：离开前台即被 RecentTasks 回收（原型实测 182 ms）；
            用户从最近任务划掉等同取消任务（autoRemoveFromRecents 在 finish 时清理卡片）。
        -->
        <activity
            android:name=".CrawlerActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
