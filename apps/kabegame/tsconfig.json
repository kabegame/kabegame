{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["./src/*"],
      "@kabegame/core/*": ["../../packages/kabegame-core/src/*"],
      "@kabegame/core/stores/*": ["../../packages/kabegame-core/src/stores/*"],
      "@kabegame/element-plus": ["../../packages/kabegame-element-plus/src/index.ts"],
      "@kabegame/element-plus/*": ["../../packages/kabegame-element-plus/src/*"],
      "@kabegame/element-plus-icons": ["../../packages/kabegame-element-plus-icons/src/index.ts"],
      "@kabegame/element-plus-icons/*": ["../../packages/kabegame-element-plus-icons/src/*"],
      "@kabegame/pathql-client": ["../../packages/kabegame-pathql-client/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "./*.ts"]
}
